# ───────────────────────────────────────────────────────────────
# CALM ME AI — muhit oʻzgaruvchilari
# Nusxa oling: cp .env.example .env.local  va kalitlarni kiriting.
# Kalit boʻlmasa ham ilova toʻliq ishlaydi (Demo rejim — qoidalarga
# asoslangan baholovchi va oldindan yozilgan oʻzbekcha javoblar).
# ───────────────────────────────────────────────────────────────

# auto | openai | gemini  (auto — qaysi kalit mavjud boʻlsa, oʻshani tanlaydi; OpenAI ustuvor)
AI_PROVIDER=auto

# OpenAI (Chat Completions, JSON rejimi; vizual kirish video-kadrlar uchun)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Ixtiyoriy: Azure/proksi uchun bazaviy URL
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (generateContent, JSON javob)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bitta AI soʻrovi uchun maksimal kutish (ms). Sekin Wi-Fi’da ilova
# shu vaqtdan soʻng avtomatik ravishda Demo dvigatelga oʻtadi.
AI_TIMEOUT_MS=8000

# on — server tomonda AI’ni butunlay oʻchiradi (sahna namoyishi uchun xavfsiz rejim)
DEMO_MODE=off
